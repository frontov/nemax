{
  "name": "family-chat",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @family-chat/api prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @family-chat/api prisma:migrate:dev",
    "seed": "pnpm --filter @family-chat/api seed",
    "backfill:chat": "pnpm --filter @family-chat/api backfill:chat",
    "test": "turbo run test"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13"
    }
  },
  "devDependencies": {
    "pnpm": "10.33.0",
    "turbo": "^2.9.6"
  }
}
